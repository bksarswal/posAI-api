# ──────────────────────────────────────────────────────────────
# POSAI API – Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env. Only .env.example is committed.
# ──────────────────────────────────────────────────────────────

# Server environment: development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=8080

# MongoDB connection string.
# Local standalone (port 27017): mongodb://localhost:27017/posai
# Local replica set via docker-compose (port 27018):
# MONGODB_URI=mongodb://localhost:27018/posai?replicaSet=rs0&directConnection=true
# Atlas: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/posai

# JWT secrets – must be at least 32 random characters each.
# In production, values starting with "change-me" are strictly rejected.
JWT_ACCESS_SECRET=change-me-to-a-random-secret-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32-chars

# Access token lifetime in minutes (default 15)
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_TTL_DAYS=7

# Allowed CORS origin – the frontend URL (no trailing slash)
CLIENT_URL=http://localhost:3000

# Bcrypt work factor (min 4, max 15, default 12; production requires >= 10).
BCRYPT_ROUNDS=12

# Auto-verify email on signup (development/test only; MUST be false in production)
AUTO_VERIFY_EMAIL=false

# Number of reverse proxies in front of Express (0 if direct, 1 behind Nginx/ALB/Cloudflare)
TRUST_PROXY=0

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
